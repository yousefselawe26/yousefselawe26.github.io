# Cache rules for Netlify and Cloudflare Pages (ignored by other hosts).
# CSS and JS are requested with a content-hash query (?v=…), so they can be cached for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
